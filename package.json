{
  "name": "wb-ai-workbench",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "WorkBuddy AI 赋能工作台 · 中小微事业群",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "smoke:files": "node scripts/file-service-smoke.mjs",
    "guard": "node scripts/guard-regression.mjs",
    "smoke:v7": "node scripts/v7-smoke.mjs",
    "smoke:pipeline": "node scripts/pipeline-smoke.mjs",
    "smoke:scene": "node scripts/scene-smoke.mjs",
    "smoke:note": "node scripts/note-smoke.mjs",
    "smoke:message": "node scripts/message-smoke.mjs",
    "smoke:dept": "node scripts/dept-smoke.mjs",
    "smoke:import": "node scripts/import-smoke.mjs",
    "smoke:scope": "node scripts/scope-smoke.mjs",
    "smoke:overflow": "node scripts/overflow-smoke.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
